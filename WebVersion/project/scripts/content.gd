static func room_at(p: Vector3) -> String:
	if p.y < -1.0: return "B1 / 培养实验室"
	if p.z > 13.8: return "00 / 后院"
	if p.x < -2.7:
		if p.z > 0: return "01 / 值班室 · 安全区"
		if p.z > -12: return "02 / 配电间"
		if p.z > -29: return "03 / 留观病房"
		return "05 / 停尸冷库"
	if p.x > 3 and p.x < 15 and p.z > -8 and p.z < 6: return "04 / 药房"
	if p.x > 14: return "06 / 东侧回廊"
	if p.z > 5: return "00 / 接待门厅"
	return "09 / 西翼走廊"
